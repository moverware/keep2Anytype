{
  "name": "keep-2-anytype",
  "version": "0.0.1",
  "description": "Convert a Google Keep export into Any-Block files that Anytype can import",
  "author": "moverware",
  "repository": "https://github.com/moverware/keep2Anytype",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~7.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "keywords": [
    "anytype",
    "google-keep",
    "migration"
  ],
  "private": true
}
